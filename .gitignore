__pycache__/
*.pyc
Pool.txt

# Large pipeline-only files live in data/ and are persisted via Actions cache (not git).
# ais_track_history.json stays in docs/ because the frontend fetches it directly.
data/vessel_profiles.json
data/ais_track_commercial.json

# Per-run archive deltas: written by fetch_ais_data.py, consumed by the workflow's
# "Append snapshot to ais-archive branch" step. Ephemeral — never tracked on main.
data/track_delta.jsonl
data/track_commercial_delta.jsonl

# 完整高風險 snapshot：analyze_suspicious.py 每輪重寫（update-ais.yml 一天
# ~17 次），只作 aggregate_highrisk.py 的累積來源，不進 git；
# 累積後的 data/highrisk_accumulator.json 才是提交的那份。
data/highrisk_snapshot.json

# 流量異常偵測輸出：cloudflare-radar.yml 每 2 小時重寫一次，只提交 docs/ 那一份
# （兩份會讓 repo 成長速度翻倍）。generate_dashboard 找不到這個檔會退回讀 docs/。
data/cf_radar.json
data/cf_radar_counties.json
# 手動探測的原始報告：跑 radar-region-probe.yml 時上傳成 artifact，不進 repo
data/radar_region_probe.json
data/ioda.json

# Guard against accidentally committing the old docs/ locations.
docs/vessel_profiles.json
docs/ais_track_commercial.json

# Per-vessel route files: regenerated by extract_all_routes.py each CI run and
# force-pushed as a single commit to the vessel-data branch (never tracked on
# main — 27k files per commit bloated history to 200MB+).
data/vessel_routes/

# Node test dependencies (jsdom/leaflet for tests/map-integration.js)
node_modules/
package.json
package-lock.json
